{
  "$schema": "https://unpkg.com/wrangler@latest/config-schema.json",
  "name": "creazzy-universal-ai",
  "main": "./cloudflare/worker.mjs",
  "compatibility_date": "2026-09-20",
  "keep_vars": true,
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./orchestrator/web/ui",
    "binding": "ASSETS",
    "run_worker_first": [
      "/healthz",
      "/v1/*",
      "/connections*",
      "/providers/*",
      "/ui*"
    ]
  }
}
